# Copy this file to .env for local development, or set these on the server.
# .env is ignored by git. Never put real values in this example file.

# Django
DEBUG=True
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# Sites allowed to call the API from a browser (comma separated). Not needed when
# the frontend proxies /api, as Netlify and the Vite dev server do.
CORS_ALLOWED_ORIGINS=

# Email for sign-up codes. Without a password, local development prints emails
# in the server terminal. For Gmail use an App Password, not the account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Online payments (Razorpay). Every order is paid online before it is placed.
# Use test keys (rzp_test_...) until the shop is ready to take real money.
# The webhook secret is the one you set for https://<your-site>/api/payments/razorpay/webhook/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shopping assistant (xAI)
XAI_API_KEY=
XAI_MODEL=grok-4.3

# Private supplier receipts (point at a persistent volume in production)
RECEIPT_ROOT=
